# Copie para .env e ajuste. Nunca versione o .env real.
# Ambiente (obrigatório) — única chave que muda o comportamento do sistema; cada um tem o seu banco, totalmente separado.
#   DESENVOLVIMENTO  banco local de trabalho, sem dados de demonstração;
#   TESTE            dados de demonstração (contas, bancas e cenários fictícios) criados automaticamente;
#   PRODUCAO         só os dados cadastrados; exige COOKIE_SECRET e recusa TIMER_SPEED.
AMBIENTE=DESENVOLVIMENTO
PORT=3000
HOST=127.0.0.1

# Banco por ambiente. Com DATABASE_URL_<AMBIENTE> vazio, usa PGlite (PostgreSQL embutido) em PGLITE_DIR_<AMBIENTE>.
DATABASE_URL_DESENVOLVIMENTO=
PGLITE_DIR_DESENVOLVIMENTO=.data/pglite
DATABASE_URL_TESTE=
PGLITE_DIR_TESTE=.data/pglite-teste
DATABASE_URL_PRODUCAO=
PGLITE_DIR_PRODUCAO=.data/pglite-producao

# Segredo usado para assinar cookies. Obrigatório em produção (mín. 32 caracteres).
COOKIE_SECRET=troque-este-segredo-em-producao-0123456789

# Duração da sessão de login, em horas.
SESSION_TTL_HOURS=12

# Modo de testes: acelera artificialmente o cronômetro (ex.: 60 = 1 min vira 1 s).
# Recusado quando AMBIENTE=PRODUCAO.
TIMER_SPEED=1

# Contagem regressiva (s) mostrada no telão e nas telas dos professores ao iniciar a apresentação (0 desliga; máx. 30).
COUNTDOWN_SECONDS=10

# Cookie "Secure" (exige HTTPS). Use true atrás de HTTPS em produção.
COOKIE_SECURE=false

# Fuso padrão de novas bancas.
DEFAULT_TIMEZONE=America/Sao_Paulo
