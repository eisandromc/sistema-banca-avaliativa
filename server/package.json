{
  "name": "@banca/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:admin": "tsx src/db/cli.ts admin"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "fastify": "5.12.5",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "vitest": "4.1.11",
    "ws": "8.22.0"
  }
}
