# Copie para .env e ajuste. Nunca versione o .env real.
# Ambiente único: não há separação entre desenvolvimento, teste e produção.
PORT=3000
HOST=127.0.0.1

# Banco de dados único. Com DATABASE_URL vazio, usa o PGlite (PostgreSQL embutido) em .data/pglite.
DATABASE_URL=

# Dados de demonstração (contas, bancas e cenários fictícios), criados ao iniciar. Deixe false com dados reais.
DADOS_DEMO=false

# Segredo usado para assinar cookies. Obrigatório (mín. 32 caracteres); troque o valor abaixo.
COOKIE_SECRET=troque-este-segredo-em-producao-0123456789

# Duração da sessão de login, em horas.
SESSION_TTL_HOURS=12

# Modo de testes: acelera artificialmente o cronômetro (ex.: 60 = 1 min vira 1 s). Mantenha 1 no uso real.
TIMER_SPEED=1

# Contagem regressiva (s) mostrada no telão e nas telas dos professores ao iniciar a apresentação (0 desliga; máx. 30).
COUNTDOWN_SECONDS=10

# Cookie "Secure" (exige HTTPS). Use true atrás de HTTPS.
COOKIE_SECURE=false

# Fuso padrão de novas bancas.
DEFAULT_TIMEZONE=America/Sao_Paulo
