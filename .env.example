# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# PostgreSQL. Se vazio, usa PGlite (PostgreSQL embutido em WASM) persistido em PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Segredo usado para assinar cookies. Obrigatório em produção (mín. 32 caracteres).
COOKIE_SECRET=troque-este-segredo-em-producao-0123456789

# Duração da sessão de login, em horas.
SESSION_TTL_HOURS=12

# Modo de testes: acelera artificialmente o cronômetro (ex.: 60 = 1 min vira 1 s).
# IGNORADO e recusado quando NODE_ENV=production.
TIMER_SPEED=1
# Contagem regressiva (s) mostrada no telão e nas telas dos professores ao iniciar a apresentação (0 desliga; máx. 30).
COUNTDOWN_SECONDS=10

# Cookie "Secure" (exige HTTPS). Use true atrás de HTTPS em produção.
COOKIE_SECURE=false

# Fuso padrão de novas bancas.
DEFAULT_TIMEZONE=America/Sao_Paulo
